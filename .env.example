# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-generate-new-one
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=saunaguide.ie,www.saunaguide.ie,.vercel.app
CSRF_TRUSTED_ORIGINS=https://saunaguide.ie,https://www.saunaguide.ie

# Neon pooled connection string; when set, the POSTGRES_* values below are ignored
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/directory_factory?sslmode=require

# PostgreSQL Configuration
POSTGRES_DB=directory_factory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here

# Connection details (for Django to connect to PostgreSQL)
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Google Places sync safety switch for legacy commands
ENABLE_GOOGLE_PLACES_SYNC=false

# Lead alerts by email (Google Workspace SMTP; EMAIL_HOST_PASSWORD is an app password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=nigel@simplesitesolutions.ie
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=nigel@simplesitesolutions.ie
ADMIN_EMAIL=nigel@simplesitesolutions.ie
